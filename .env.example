# .env にコピーして使う（.env はGit管理外）。環境変数で指定した値が優先される。

# Nightdrop と共有するトークン。未設定の場合は受信を受け付けない。
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(32))"
VIEWER_UPLOAD_TOKEN=

# 受信した画像の保存先（相対パスは server.py のあるフォルダ基準）
VIEWER_LIBRARY_DIR=library

# 重複判定のDB（nightdrop.db）と受信ログ（upload.log）の保存先
VIEWER_DATA_DIR=data

# 1枚あたりの上限サイズ（MB）
VIEWER_MAX_UPLOAD_MB=50

VIEWER_HOST=0.0.0.0
VIEWER_PORT=5000
